{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FFmpeg Queue Manager",
  "version": "0.1.9",
  "identifier": "com.ffmpegqueue.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FFmpeg Queue Manager",
        "width": 800,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/EarthasaurusRex/ffmpeg-queue-manager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEQ0JFOENCMTMxQjZGOTEKUldTUmJ4c1R5K2pMZmQwNVhuSkk2NzR3L2hNcTNWS01zc1F2bXNDZnhaTks4SHh3MGVPSXlYdWoK"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["bin/ffmpeg", "bin/ffprobe"],
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
