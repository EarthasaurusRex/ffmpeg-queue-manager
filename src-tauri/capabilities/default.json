{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    "os:default",
    "updater:default",
    "process:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": true
        },
        {
          "name": "bin/ffmpeg",
          "cmd": "bin/ffmpeg",
          "args": true,
          "sidecar": true
        },
        {
          "name": "bin/ffprobe",
          "cmd": "bin/ffprobe",
          "args": true,
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "bin/ffmpeg",
          "cmd": "bin/ffmpeg",
          "args": true,
          "sidecar": true
        }
      ]
    },
    "fs:default"
  ]
}